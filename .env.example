# Copy to .env.local for local dev. In Vercel, set these in Project Settings → Environment Variables.
# NEVER commit real values.

# --- Supabase (public: safe in the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>

# --- Server only (do NOT prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>      # only for admin scripts / audit writes
ANTHROPIC_API_KEY=<your-anthropic-api-key>
AI_MODEL=claude-sonnet-5-5

# --- Location import script only (run from your laptop, never in Vercel) ---
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Plan text (Phase 8). Server-only; never NEXT_PUBLIC_. ---
# Unset or "none" = standard wording (free, no data leaves the system). "gateway" = write with AI via Vercel AI Gateway.
AI_PROVIDER=
# Gateway model id. Cheapest good option: anthropic/claude-haiku-5-5. Spec default: anthropic/claude-sonnet-5-5.
AI_MODEL=
# Only needed outside Vercel (on Vercel the gateway authenticates automatically).
AI_GATEWAY_API_KEY=
# Max AI-written plans per user per 24 h (sign-up is open).
PLAN_DAILY_AI_LIMIT=10
